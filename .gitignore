# Web client local artifacts
web/node_modules/
web/dist/
/.env.web
/.playwright-cli/
/output/playwright/
/server/blobs-web/
/server/logs-web/
web/.env*
!web/.env.example
web/*.tsbuildinfo
scripts/__pycache__/

# Learning Space desktop app
space/node_modules/
space/out/
space/dist/

