# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcresult

# Swift Package Manager
.build/

# Local development secrets (read by scripts/sync-backend-config.sh)
.env.local
# The device token, compiled into the app from here. Never commit this.
MathTutor/Config/Backend.local.xcconfig

# macOS
.DS_Store

# Backend service local secrets
server/.env
server/blobs/
server/.venv/
server/.pytest_cache/
server/**/__pycache__/
server/logs/
server/server.log

# Web client local artifacts
web/node_modules/
web/dist/
/.env.web
/.playwright-cli/
/output/playwright/
/server/blobs-web/
/server/logs-web/
web/.env*
!web/.env.example
web/*.tsbuildinfo
scripts/__pycache__/

# Learning Space desktop app
space/node_modules/
space/out/
space/dist/
space/release/
# electron-builder resources (entitlements); the Xcode rule above ignores build/.
!space/build/

# Third-party reference material (Paper agent interface), local only
docs/learning-space/reference/

# Live-drawing lab runs (space/scripts/lab)
space/.lab/
.claude/worktrees/

# Scene videos for sharing (local only)
share-videos/

# Videos stay local (lab recordings, comparisons): never in git
*.mp4
*.mov
*.webm
*.mkv

# Images stay local unless they are product or design assets (founder, 2026-10-29):
# screenshots from checks, labs, tests, debugging and design iterations never go into git.
# An approved design screenshot that should stay goes to docs/learning-space/design-images/.
# The exceptions name image files only, so they never bring back an ignored folder.
# Images already in git (Vendor/, the paused clients) stay tracked.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!assets/**/*.gif
!assets/**/*.webp
!design/**/*.png
!design/**/*.jpg
!design/**/*.jpeg
!design/**/*.gif
!design/**/*.webp
!docs/images/**/*.png
!docs/images/**/*.jpg
!docs/images/**/*.jpeg
!docs/images/**/*.gif
!docs/images/**/*.webp
!docs/learning-space/design-images/**/*.png
!docs/learning-space/design-images/**/*.jpg
!docs/learning-space/design-images/**/*.jpeg
!docs/learning-space/design-images/**/*.gif
!docs/learning-space/design-images/**/*.webp
!landing-page/public/**/*.png
!landing-page/public/**/*.jpg
!landing-page/public/**/*.jpeg
!landing-page/public/**/*.gif
!landing-page/public/**/*.webp
# The website's product images (the app screenshot under the hero): product assets.
!apps/website/public/**/*.png
!apps/website/public/**/*.jpg
!apps/website/public/**/*.jpeg
!apps/website/public/**/*.gif
!apps/website/public/**/*.webp
!space/resources/**/*.png
!space/resources/**/*.jpg
!space/resources/**/*.jpeg
!space/resources/**/*.gif
!space/resources/**/*.webp

# Browser-check logs and local website videos (not for git)
.playwright-mcp/
apps/website/public/video/
