# Build output
build/

# Local development secrets
.env.local

# macOS
.DS_Store

# Askaboard desktop app
apps/desktop/node_modules/
apps/desktop/out/
apps/desktop/dist/
apps/desktop/release/
# electron-builder resources (entitlements); the build output rule above ignores build/.
!apps/desktop/build/

# Third-party reference material (Paper agent interface), local only
docs/reference/

# Live-drawing lab runs (apps/desktop/scripts/lab)
apps/desktop/.lab/
.claude/worktrees/

# Videos stay local (lab recordings, comparisons): never in git
*.mp4
*.mov
*.webm
*.mkv

# Images stay local unless they are product or design assets (founder, 2026-10-29):
# screenshots from checks, labs, tests, debugging and design iterations never go into git.
# An approved design screenshot that should stay goes to docs/design-images/.
# The exceptions name image files only, so they never bring back an ignored folder.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!assets/**/*.gif
!assets/**/*.webp
# The macOS DMG window background (assets/brand/export.mjs makes both).
!apps/desktop/build/dmg-background.png
!apps/desktop/build/dmg-background@2x.png
!docs/design-images/**/*.png
!docs/design-images/**/*.jpg
!docs/design-images/**/*.jpeg
!docs/design-images/**/*.gif
!docs/design-images/**/*.webp
# The website's product images (the app screenshot under the hero): product assets.
!apps/website/public/**/*.png
!apps/website/public/**/*.jpg
!apps/website/public/**/*.jpeg
!apps/website/public/**/*.gif
!apps/website/public/**/*.webp
!apps/desktop/resources/**/*.png
!apps/desktop/resources/**/*.jpg
!apps/desktop/resources/**/*.jpeg
!apps/desktop/resources/**/*.gif
!apps/desktop/resources/**/*.webp

# Browser-check logs and local website videos (not for git)
.playwright-mcp/
apps/website/public/video/

# Old agent reports and diffs (local only; removed from git 2026-11-08)
.superpowers/
