{
  "name": "learning-space",
  "productName": "Learning Space",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "A shared canvas and a local learning folder for you and your AI agent.",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/build-relay.mjs && electron-vite dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "npm run typecheck && electron-vite build && node scripts/build-relay.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "start": "electron-vite preview",
    "dist:mac": "node scripts/dist-mac.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "acorn": "^8.18.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clipper-lib": "^6.4.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wawoff2": "^2.0.1"
  }
}
