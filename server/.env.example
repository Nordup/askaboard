OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql+asyncpg://user:pass@host/db
DEVICE_TOKEN=generate-with-python-secrets-token-urlsafe-32
# Local browser login; keep both values server-side and out of the web bundle.
WEB_BOOTSTRAP_CODE=choose-a-short-lived-local-access-code
WEB_SESSION_SECRET=generate-a-distinct-random-signing-secret
WEB_SESSION_TTL_SECONDS=43200
WEB_SESSION_SECURE=false
WEB_ALLOWED_HOSTS=["localhost:5173","127.0.0.1:5173","localhost:8000","127.0.0.1:8000","localhost:8080","127.0.0.1:8080"]
# Optional built frontend directory; when set, FastAPI serves its index and assets.
# WEB_DIST_DIR=../web/dist
BLOB_DIR=./blobs
DAILY_SPEND_CAP_USD=5.0
PERSIST_DICTATION_AUDIO=true

# LangSmith observability (Phase 0). Tracing defaults to off; leave the key
# empty to keep the service a true no-op even if tracing is enabled.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=math-tutor
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=...

# A dedicated Neon branch. Database tests DROP every table on this URL, so it
# must never be the branch the app itself uses.
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@host/db
LOG_DIR=./logs
